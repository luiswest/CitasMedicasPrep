openapi: 3.0.0
info:
  title: 'Citas Médicas - Business API'
  description: 'API de negocio para consultar y registrar médicos. Las operaciones son delegadas al Data Service.'
  version: 1.0.0
paths:
  /api/medicos:
    get:
      tags:
        - Médicos
      summary: 'Listar médicos'
      operationId: listarMedicos
      responses:
        '200':
          description: 'Lista de médicos'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MedicoResponse'
        '502':
          description: 'Data Service no disponible'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
      servers:
        -
          url: 'http://localhost:9090'
          description: 'Servidor local de Business'
    post:
      tags:
        - Médicos
      summary: 'Registrar un médico'
      operationId: crearMedico
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CrearMedico'
      responses:
        '201':
          description: 'Médico creado'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MedicoItemResponse'
        '422':
          description: 'Datos inválidos'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '502':
          description: 'Data Service no disponible'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
      servers:
        -
          url: 'http://localhost:9090'
          description: 'Servidor local de Business'
  '/api/medicos/{id}':
    get:
      tags:
        - Médicos
      summary: 'Obtener un médico'
      operationId: obtenerMedico
      parameters:
        -
          name: id
          in: path
          description: 'Identificador del médico'
          required: true
          schema:
            type: integer
            format: int64
            minimum: 1
          example: 1
      responses:
        '200':
          description: 'Médico encontrado'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MedicoItemResponse'
        '404':
          description: 'Médico no encontrado'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '502':
          description: 'Data Service no disponible'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
      servers:
        -
          url: 'http://localhost:9090'
          description: 'Servidor local de Business'
components:
  schemas:
    Medico:
      required:
        - id
        - especialidad_id
        - nombre_completo
        - licencia
      properties:
        id:
          type: integer
          format: int64
          example: 1
        especialidad_id:
          type: integer
          format: int64
          example: 1
        nombre_completo:
          type: string
          example: 'Armando West Grant'
          maxLength: 150
        licencia:
          type: string
          example: LIC-123415
          maxLength: 50
        telefono:
          type: string
          example: 8888-7771
          nullable: true
          maxLength: 20
      type: object
    CrearMedico:
      required:
        - especialidad_id
        - nombre_completo
        - licencia
        - username
        - password
      properties:
        especialidad_id:
          type: integer
          format: int64
          example: 1
          minimum: 1
        nombre_completo:
          type: string
          example: 'Armando West Grant'
          maxLength: 150
        licencia:
          type: string
          example: LIC-123415
          maxLength: 50
        telefono:
          type: string
          example: 8888-7771
          nullable: true
          maxLength: 20
        username:
          type: string
          example: armandowest
          maxLength: 50
        password:
          type: string
          format: password
          example: securepassword
          minLength: 8
      type: object
    MedicoResponse:
      required:
        - data
      properties:
        data:
          type: array
          items:
            $ref: '#/components/schemas/Medico'
      type: object
    MedicoItemResponse:
      required:
        - data
      properties:
        data:
          $ref: '#/components/schemas/Medico'
      type: object
    ErrorResponse:
      required:
        - error
      properties:
        error:
          type: string
          example: 'Médico no encontrado.'
      type: object
tags:
  -
    name: Médicos
    description: 'Operaciones sobre médicos'
